# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Packaging and build artifacts
build/
dist/
*.egg-info/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated records. --output writes wherever it is told; this is the
# conventional place to put them, and nothing generated belongs in the history.
datasets/
# The name the quickstart and the CI smoke test both write to.
record.json

# Local environment and editor state
.env
.env.local
.vscode/
.idea/
.DS_Store

# Persistent browser profile used by --emit docs to keep the Google login.
.typetrace-browser-profile/

# Scratch
*.log
*.tmp
*.swp
